# OpenRouter — text LLM (copy, localization, art direction, compliance) and background images
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_TEXT_MODEL=anthropic/claude-sonnet-4
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Optional overrides
PIPELINE_OUTPUT_DIR=outputs
PIPELINE_STATE_DIR=outputs/.state
